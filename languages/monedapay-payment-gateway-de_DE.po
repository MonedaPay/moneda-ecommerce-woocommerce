msgstr "Zahlung über MonedaPay-Webhook abgeschlossen"

#: includes/REST/OrderUpdateStatusHandler.php:186
msgid "Payment pending via MonedaPay"
msgstr "Zahlung über MonedaPay ausstehend"

#: includes/REST/OrderUpdateStatusHandler.php:192
msgid "Payment failed or cancelled via MonedaPay"
msgstr "Zahlung über MonedaPay fehlgeschlagen oder abgebrochen"

