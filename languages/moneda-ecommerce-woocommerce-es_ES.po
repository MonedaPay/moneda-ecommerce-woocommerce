#: includes/Gateway.php:161
msgid "Encryption Key"
msgstr "Clave de Cifrado"

#: includes/Gateway.php:320
msgid "Encryption Key is required when the gateway is enabled."
msgstr "La Clave de Cifrado es obligatoria cuando la pasarela está activada."

#: includes/Gateway.php:322
msgid ""
"Encryption Key must be 24 characters long and contain only alphanumeric "
"characters."
msgstr ""
"La Clave de Cifrado debe tener 24 caracteres y contener solo caracteres "
"alfanuméricos."

#. %s: Environment name
#: includes/Gateway.php:136
#, php-format
