msgstr "Journalisez les événements MonedaPay dans %1$s. Vous pouvez consulter les journaux dans %2$s."

#: includes/Gateway.php:176
msgid "WooCommerce > Status > Logs"
msgstr "WooCommerce > État > Journaux"

#: includes/Gateway.php:232
msgid "Order not found."
msgstr "Commande non trouvée."

