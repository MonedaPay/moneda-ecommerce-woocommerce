{
    "name": "monedapay/moneda-ecommerce-woocommerce",
    "description": "Ari10 Pay Payment Gateway for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
   "version": "1.0.4",
    "authors": [
        {
            "name": "MonedaPay Team",
            "email": "developers@monedapay.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ari10/moneda-pay-lib": "dev-master",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "brain/monkey": "2.*",
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^1.0",
        "wp-coding-standards/wpcs": "3.1.0",
        "phpcompatibility/php-compatibility": "9.3",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "v1.3",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcsstandards/phpcsextra": "^1.0",
        "php-stubs/woocommerce-stubs": "7.7",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "MonedaPay\\PaymentGateway\\": "includes/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcs-fix": "phpcbf",
        "phpstan": "php -d memory_limit=2G ./vendor/bin/phpstan analyse",
        "tests": "composer phpcs-fix && composer phpcs && composer phpstan",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
